# Copy to .env. Node 22+ is required. Never commit .env.
PORT=3000
APP_ORIGIN=http://localhost:3000
# Empty uses a development-only JSON store in .data. Required in production.
MONGODB_URI=
MONGODB_DATABASE=trao_interview_studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Recommended for public interview research. Missing key is reported as a warning.
TAVILY_API_KEY=
# Tune to YOUR model's quota. Requests are serialized across all jobs in this process.
LLM_MIN_INTERVAL_MS=4500
LLM_TOKENS_PER_MINUTE=60000
PIPELINE_TIMEOUT_MS=165000
# CLI-only local fixture access. Ignored by the web application.
EVALUATE_ALLOW_LOCAL=true
# Set only behind one trusted reverse proxy; defaults to no proxy trust.
TRUST_PROXY=0
